# SQLite のファイルパス（prisma/ ディレクトリからの相対パス）
DATABASE_URL="file:./dev.db"

# 妊婦確認の審査画面（/admin/verifications）を開けるアカウント。カンマ区切り
ADMIN_EMAILS="mikan@example.com"

# アプリの公開オリジン。マイナポータルに登録する戻り先と完全に一致させる。
# 未設定なら実際のリクエストのホストから組み立てる（開発時はこれで十分）
# APP_ORIGIN="https://example.com"

# マイナポータル 自己情報取得API
#   mock = アプリ内の擬似同意画面で開発する（利用申請の承認前はこちら）
#   live = 本番の認可サーバーに接続する
MYNA_MODE="mock"
# 以下は利用申請の承認後に発行される接続情報。live のときだけ必要
# MYNA_AUTHORIZE_URL=""
# MYNA_TOKEN_URL=""
# MYNA_SELFINFO_URL=""
# MYNA_CLIENT_ID=""
# MYNA_CLIENT_SECRET=""
# MYNA_SCOPE="selfinfo.maternity"
