// 妊婦さん同士のママ友マッチング「マタマッチ」データモデル
//
// プライバシー方針（重要）:
//   - 本名・住所・電話番号・医療記録は一切保持しない
//   - 居住地は「都道府県 + 市区町村」までに留める
//   - 出産予定日は妊娠週数の算出のみに使い、生の日付は本人以外に表示しない

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  nickname              String
  dueDate               DateTime // 出産予定日（週数算出用。他ユーザーには週数のみ公開）
  prefecture            String
  city                  String
  birthOrder            String // "first" = 初産 / "experienced" = 経産
  /// constants.ts の AGE_GROUPS の id。登録時は任意なので空文字になりうる
  ageGroup              String    @default("")
  interests             String    @default("") // タグ id のカンマ区切り
  bio                   String    @default("")
  wantMeetup            Boolean   @default(false) // オフラインで会うことに前向きか
  /// 妊婦であることの確認。none | pending | verified | expired | rejected
  verificationStatus    String    @default("none")
  /// "myna"（マイナポータル連携）| "boshi_techo"（母子健康手帳）| "clinic"（産院連携）
  verificationMethod    String?
  verifiedAt            DateTime?
  /// 出産予定日 + 8週で失効させ、産後モードへ移行させる
  verificationExpiresAt DateTime?
  /// 認証済みの相手としかマッチしない
  requireVerifiedMatch  Boolean   @default(false)

  acceptCalls  Boolean  @default(true) // アプリ内通話を受け付けるか
  callFromHour Int      @default(10) // 通話を受け付ける時間帯（開始・24時間表記）
  callToHour   Int      @default(21) // 通話を受け付ける時間帯（終了）
  avatarSeed   String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentLikes     Like[]                @relation("likeSender")
  receivedLikes Like[]                @relation("likeReceiver")
  matchesAsA    Match[]               @relation("matchUserA")
  matchesAsB    Match[]               @relation("matchUserB")
  messages      Message[]
  blocksMade    Block[]               @relation("blocker")
  blocksAgainst Block[]               @relation("blocked")
  reportsMade   Report[]              @relation("reporter")
  callsMade     Call[]                @relation("callCaller")
  callsReceived Call[]                @relation("callCallee")
  verifications VerificationRequest[]

  @@index([prefecture])
  @@index([verificationStatus])
}

/// 片方向の「いいね」。相互になった時点で Match を作る
model Like {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("likeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("likeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

/// 相互いいね成立。userAId < userBId で正規化して重複を防ぐ
model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA    User      @relation("matchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("matchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]
  calls    Call[]

  @@unique([userAId, userBId])
}

model Message {
  id        String   @id @default(cuid())
  matchId   String
  senderId  String
  /// "text" = 通常のメッセージ / "call" = 通話の記録（発信・不在着信・通話時間）
  kind      String   @default("text")
  body      String
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

/// ブロック。おすすめ一覧・いいね一覧の双方から相互に除外される
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String
  detail     String   @default("")
  createdAt  DateTime @default(now())

  reporter User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reportedId])
}

/// アプリ内音声通話。電話番号は交換せず、マッチ済みの相手とだけつながる。
/// status: ringing（呼び出し中）→ active（通話中）→ ended / declined / missed / canceled
model Call {
  id          String    @id @default(cuid())
  matchId     String
  callerId    String
  calleeId    String
  status      String    @default("ringing")
  /// 「15分だけ話せませんか？」のような、呼び出しに添える一言
  note        String    @default("")
  createdAt   DateTime  @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?
  durationSec Int       @default(0)

  match   Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  caller  User         @relation("callCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee  User         @relation("callCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  signals CallSignal[]

  @@index([calleeId, status])
  @@index([callerId, status])
  @@index([matchId, createdAt])
}

/// WebRTC の SDP / ICE candidate を相手に受け渡すためだけの一時テーブル。
/// 音声そのものはサーバーを通らず、端末間で直接やりとりされる。
model CallSignal {
  id        Int      @id @default(autoincrement())
  callId    String
  fromId    String
  kind      String // "offer" | "answer" | "candidate"
  payload   String
  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, id])
}

/// 妊婦確認の審査キュー。
///
/// 個人情報の扱い（重要）:
///   - 母子健康手帳の画像は「出産予定日が載ったページ1枚のみ・氏名と住所はマスキング」で提出させる
///   - 画像は公開ディレクトリの外に一時保存し、**審査の結果が出た時点で実体ごと削除する**
///   - 審査後に残すのは「いつ・どの方法で確認したか」と確認できた出産予定日だけ
model VerificationRequest {
  id              String    @id @default(cuid())
  userId          String
  method          String // "myna" | "boshi_techo" | "clinic"
  /// 一時ファイルへの参照。審査完了時に null にし、ファイル本体も削除する
  evidenceRef     String?
  /// 本人が申告した出産予定日（審査時に証跡と突き合わせる）
  declaredDueDate DateTime
  status          String    @default("pending") // pending | approved | rejected
  reviewedAt      DateTime?
  rejectReason    String    @default("")
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

/// マイナポータルへ送り出してから戻ってくるまでの一時的な状態（OAuth の state）。
/// CSRF 対策と、戻り先のユーザー特定のためだけに使い、使ったら消費済みにする。
model MynaLinkSession {
  state        String    @id
  userId       String
  codeVerifier String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([expiresAt])
}
